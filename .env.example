# Copy to .env and fill in. Never commit the real .env.

# --- Claude (main chat model) ---
ANTHROPIC_API_KEY=
# Used for classify and for writing answers
LLM_FAST_MODEL=claude-haiku-5-5
# Used for writing SQL. Switch to a stronger model if SQL quality is poor (see README).
LLM_SQL_MODEL=claude-haiku-5-5

# --- Gemini (embeddings + fallback chat model if Claude fails) ---
GOOGLE_API_KEY=
# Optional fallback chat model. Default: gemini-2.5-flash
LLM_MODEL=

# --- Compensation database (use the READ-ONLY user) ---
# If the app runs inside Docker, use host.docker.internal instead of localhost.
DATABASE_URL=postgresql+psycopg://hr_readonly:@localhost:5432/compensation
# Comma-separated allowlist of tables the LLM may see. Empty = all tables.
COMP_TABLES=employees,salary_records,departments,job_levels

# --- Vector database (pgvector container from docker-compose) ---
VECTOR_DB_USER=hr_vectors
VECTOR_DB_PASSWORD=change-me
VECTOR_DB_NAME=hr_vectors
# Used when running the app outside Docker. docker-compose overrides it for the container.
VECTOR_DATABASE_URL=postgresql+psycopg://hr_vectors:change-me@localhost:5433/hr_vectors
# Gemini embeddings (gemini-embedding-001, 768 dimensions) live in their own collection.
VECTOR_COLLECTION=hr_policies_gemini

# --- Auth (must match the compensation app: HS256, role in the "role" claim) ---
JWT_SECRET=
JWT_ROLE_CLAIM=role
HR_ROLE_VALUE=HR_MANAGER
